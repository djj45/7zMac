 #include "ZipHandler.h"
 
+#ifndef _WIN32
+// 7zMac patch: convert ZIP password to a legacy code page (e.g. GBK) with iconv
+#include <iconv.h>
+
+static const char *My_Pass_CodePageName(UInt32 cp)
+{
+  switch (cp)
+  {
+    case 936:   return "GB18030";
+    case 54936: return "GB18030";
+    case 950:   return "BIG5";
+    case 932:   return "SHIFT_JIS";
+    case 949:   return "CP949";
+    default:    return NULL;
+  }
+}
+
+static bool My_Pass_From_Unicode(AString &dest, const wchar_t *src, UInt32 cp)
+{
+  const char *name = My_Pass_CodePageName(cp);
+  if (!name || sizeof(wchar_t) != 4)
+    return false;
+  size_t numChars = 0;
+  while (src[numChars] != 0)
+    numChars++;
+  CByteBuffer inBuf(numChars * 4 + 4);
+  Byte *p = inBuf;
+  for (size_t i = 0; i < numChars; i++)
+    SetUi32(p + i * 4, (UInt32)src[i])
+  CByteBuffer outBuf(numChars * 4 + 4);
+  iconv_t cd = iconv_open(name, "UTF-32LE");
+  if (cd == (iconv_t)-1)
+    return false;
+  char *in = reinterpret_cast<char *>(static_cast<Byte *>(inBuf));
+  size_t inLeft = numChars * 4;
+  char *out = reinterpret_cast<char *>(static_cast<Byte *>(outBuf));
+  size_t outLeft = outBuf.Size();
+  const size_t r = iconv(cd, &in, &inLeft, &out, &outLeft);
+  iconv_close(cd);
+  if (r == (size_t)-1 || inLeft != 0)
+    return false;
+  dest.SetFrom(reinterpret_cast<const char *>(static_cast<const Byte *>(outBuf)), (unsigned)(outBuf.Size() - outLeft));
+  return true;
+}
+#endif
+
